APP_NAME=Pawpile
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/pawpile.db

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
OPENAI_API_AUTH_REQUIRED=true

MODELS_DIR=./models
DATA_DIR=./data
LOGS_DIR=./logs

LLAMA_SERVER_PATH=/opt/llama.cpp/build/bin/llama-server
LLAMA_HOST=127.0.0.1
LLAMA_BASE_PORT=9100
LLAMA_HEALTH_TIMEOUT_SECONDS=5
LLAMA_STARTUP_TIMEOUT_SECONDS=120
LLAMA_REQUEST_TIMEOUT_SECONDS=300
INFERENCE_SERVICE_URL=http://localhost:8100
INFERENCE_RUNTIME_URLS=
INFERENCE_SERVICE_TIMEOUT_SECONDS=300

DEFAULT_CONTEXT_LENGTH=8192
DEFAULT_THREADS=8
DEFAULT_GPU_LAYERS=-1

# Optional: target a specific AMD GPU ISA when building the ROCm image.
# Example values: gfx1100 for RX 7900 series, gfx1201 for Radeon AI PRO R9700.
AMDGPU_TARGETS=

QUEUE_MAX_SIZE=1000
QUEUE_POLL_INTERVAL_MS=100

FRONTEND_ORIGIN=http://localhost:5173
SUPPORTED_DEVICES=
