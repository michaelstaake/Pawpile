FROM rocm/dev-ubuntu-22.04:6.1.2

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libcurl4-openssl-dev \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

COPY requirements.txt ./
RUN pip3 install --no-cache-dir -r requirements.txt

ENV PATH=/opt/rocm/bin:/opt/rocm/llvm/bin:$PATH
ENV ROCM_PATH=/opt/rocm

# AMDGPU_TARGETS can be overridden at build time (e.g. gfx1100 for RX 7900, gfx1030 for RX 6800).
# Leave unset to let llama.cpp build for the most common targets.
ARG AMDGPU_TARGETS=""

RUN git clone --depth 1 https://github.com/ggerganov/llama.cpp.git /opt/llama.cpp \
    && cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
        -DLLAMA_BUILD_SERVER=ON \
        -DGGML_HIP=ON \
        -DCMAKE_C_COMPILER=/opt/rocm/llvm/bin/clang \
        -DCMAKE_CXX_COMPILER=/opt/rocm/llvm/bin/clang++ \
        -DCMAKE_BUILD_TYPE=Release \
        $( [ -n "$AMDGPU_TARGETS" ] && echo "-DAMDGPU_TARGETS=$AMDGPU_TARGETS" ) \
    && cmake --build /opt/llama.cpp/build --config Release --target llama-server -j2

COPY app ./app

RUN mkdir -p /app/models /app/logs

ENV LLAMA_SERVER_PATH=/opt/llama.cpp/build/bin/llama-server
ENV SUPPORTED_DEVICES=cpu,amd

EXPOSE 8100

CMD ["uvicorn", "app.inference_service:app", "--host", "0.0.0.0", "--port", "8100"]
