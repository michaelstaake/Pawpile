FROM rocm/dev-ubuntu-24.04:6.4.1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    hipblas-dev \
    rocblas-dev \
    libcurl4-openssl-dev \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

COPY requirements.txt ./
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

ENV PATH=/opt/venv/bin:/opt/rocm/bin:/opt/rocm/llvm/bin:$PATH
ENV ROCM_PATH=/opt/rocm

# Build a portable fat binary for the most common ROCm desktop targets by default.
# Override AMDGPU_TARGETS at build time to narrow the image for a specific deployment.
ARG AMDGPU_TARGETS="gfx1030;gfx1100;gfx1101;gfx1102;gfx1200;gfx1201"

RUN git clone --depth 1 https://github.com/ggerganov/llama.cpp.git /opt/llama.cpp \
    && CMAKE_GPU_TARGETS="" \
    && if [ -n "$AMDGPU_TARGETS" ]; then CMAKE_GPU_TARGETS="-DGPU_TARGETS=$AMDGPU_TARGETS"; fi \
    && HIPCXX=/opt/rocm/llvm/bin/clang++ HIP_PATH=/opt/rocm \
       cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
        -DLLAMA_BUILD_SERVER=ON \
        -DGGML_HIP=ON \
        -DCMAKE_PREFIX_PATH=/opt/rocm/lib/cmake:/opt/rocm \
        -DCMAKE_C_COMPILER=/opt/rocm/llvm/bin/clang \
        -DCMAKE_CXX_COMPILER=/opt/rocm/llvm/bin/clang++ \
        -DCMAKE_BUILD_TYPE=Release \
        $CMAKE_GPU_TARGETS \
    && cmake --build /opt/llama.cpp/build --config Release --target llama-server -j2

COPY app ./app

RUN mkdir -p /app/models /app/logs

ENV LLAMA_SERVER_PATH=/opt/llama.cpp/build/bin/llama-server
ENV SUPPORTED_DEVICES=cpu,amd

EXPOSE 8100

CMD ["uvicorn", "app.inference_service:app", "--host", "0.0.0.0", "--port", "8100"]
