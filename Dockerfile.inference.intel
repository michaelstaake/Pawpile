FROM intel/oneapi-basekit:2025.3.2-0-devel-ubuntu24.04

WORKDIR /app

# Install system dependencies including venv
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libcurl4-openssl-dev \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Intel GPU runtimes from the base image's configured repositories
RUN apt-get update && apt-get install -y --no-install-recommends \
    intel-level-zero-gpu \
    intel-opencl-icd \
    clinfo \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

ARG XPU_SMI_DEB_URL=https://github.com/intel/xpumanager/releases/download/v1.3.6/xpu-smi_1.3.6_20260206.143628.1004f6cb.u24.04_amd64.deb
RUN curl -fsSL "$XPU_SMI_DEB_URL" -o /tmp/xpu-smi.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/xpu-smi.deb \
    && rm -f /tmp/xpu-smi.deb \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment and install requirements (AMD-style)
COPY requirements.txt ./
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Add venv and oneAPI to PATH
ENV PATH=/opt/venv/bin:/opt/intel/oneapi/compiler/latest/bin:$PATH

# Build llama.cpp with SYCL using all CPU cores
RUN git clone --depth 1 https://github.com/ggerganov/llama.cpp.git /opt/llama.cpp && \
    bash -lc "source /opt/intel/oneapi/setvars.sh --force && \
    cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
        -DLLAMA_BUILD_SERVER=ON \
        -DGGML_SYCL=ON \
        -DGGML_SYCL_TARGET=INTEL \
        -DCMAKE_C_COMPILER=icx \
        -DCMAKE_CXX_COMPILER=icpx \
        -DCMAKE_BUILD_TYPE=Release \
        -DGGML_SYCL_F16=ON \
        -DCMAKE_CXX_FLAGS='-Wno-error=maybe-uninitialized -Wno-error=unused-variable' && \
    cmake --build /opt/llama.cpp/build --config Release --target llama-server -j2"

COPY app ./app

RUN mkdir -p /app/models /app/logs

ENV LLAMA_SERVER_PATH=/opt/llama.cpp/build/bin/llama-server
ENV SUPPORTED_DEVICES=cpu,intel

EXPOSE 8100

# Start with proper oneAPI environment
CMD ["bash", "-lc", "source /opt/intel/oneapi/setvars.sh --force >/dev/null && exec uvicorn app.inference_service:app --host 0.0.0.0 --port 8100"]